// Ticket Booking System — authoritative schema.
//
// Supabase needs two connection strings and mixing them up is the classic
// "works locally, breaks on deploy" bug:
//   DATABASE_URL — transaction pooler, :6543, ?pgbouncer=true — the app
//   DIRECT_URL   — session pooler,     :5432                  — migrations only
// Migrations take advisory locks, which are session state; the transaction
// pooler discards session state between statements. See apps/api/.env.example.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(CUSTOMER)
  name         String
  createdAt    DateTime @default(now())

  eventsOrganised Event[]         @relation("Organiser")
  bookings        Booking[]
  waitlistEntries WaitlistEntry[]
}

enum Role {
  CUSTOMER
  ORGANISER
  ADMIN
}

model Venue {
  id      String  @id @default(uuid())
  name    String
  address String
  seats   Seat[]
  events  Event[]
}

/// Physical geometry, written once per venue. Carries no status —
/// a chair does not know whether it is sold.
model Seat {
  id      String @id @default(uuid())
  venue   Venue  @relation(fields: [venueId], references: [id])
  venueId String
  section String // e.g. "Balcony", "Floor"
  row     String // e.g. "A"
  number  Int // e.g. 12
  posX    Float // for the visual seat grid
  posY    Float

  showSeats ShowSeat[]

  @@unique([venueId, section, row, number])
}

model Event {
  id          String    @id @default(uuid())
  organiser   User      @relation("Organiser", fields: [organiserId], references: [id])
  organiserId String
  venue       Venue     @relation(fields: [venueId], references: [id])
  venueId     String
  title       String
  type        EventType
  description String?

  categories SeatCategory[]
  shows      Show[]
}

enum EventType {
  MOVIE
  CONCERT
}

model SeatCategory {
  id      String  @id @default(uuid())
  event   Event   @relation(fields: [eventId], references: [id])
  eventId String
  name    String // "Premium", "Standard"
  price   Decimal

  /// Which venue sections this price band covers, e.g. ["Floor", "Balcony"].
  /// Seats belong to a venue and categories belong to an event, so without
  /// this there is nothing to tell instantiateShowSeats() what a seat costs.
  /// Validated on write: every section must exist in the event's venue, and
  /// no two categories in one event may claim the same section.
  sections String[]

  showSeats       ShowSeat[]
  waitlistEntries WaitlistEntry[]

  @@unique([eventId, name])
}

model Show {
  id       String   @id @default(uuid())
  event    Event    @relation(fields: [eventId], references: [id])
  eventId  String
  startsAt DateTime

  showSeats       ShowSeat[]
  waitlistEntries WaitlistEntry[]
  bookings        Booking[]
}

/// One row per seat per show, generated at show-creation time by
/// instantiateShowSeats(). This — not the physical Seat — carries live
/// status, price band, and hold/offer state. Every hold, release, booking
/// and offer locks this row with SELECT ... FOR UPDATE.
model ShowSeat {
  id             String       @id @default(uuid())
  show           Show         @relation(fields: [showId], references: [id])
  showId         String
  seat           Seat         @relation(fields: [seatId], references: [id])
  seatId         String
  category       SeatCategory @relation(fields: [categoryId], references: [id])
  categoryId     String
  status         SeatStatus   @default(AVAILABLE)
  /// Never leaves the server. The public seat map shows that a seat is held,
  /// never who is holding it.
  heldByUserId   String?
  holdExpiresAt  DateTime?
  offerExpiresAt DateTime?

  bookingSeat BookingSeat?

  @@unique([showId, seatId])
  @@index([showId, status])
}

enum SeatStatus {
  AVAILABLE
  HELD
  OFFERED // held open for one specific waitlisted customer
  BOOKED
}

model Booking {
  id          String        @id @default(uuid())
  reference   String        @unique // human-facing, e.g. "BK-7F3K2"
  customer    User          @relation(fields: [customerId], references: [id])
  customerId  String
  show        Show          @relation(fields: [showId], references: [id])
  showId      String
  status      BookingStatus @default(CONFIRMED)
  /// Opaque 32-byte token encoded in the QR as a /verify/{token} URL.
  /// Never Math.random(), never counter-derived — it is a bearer credential.
  qrToken     String        @unique
  createdAt   DateTime      @default(now())
  cancelledAt DateTime?

  seats BookingSeat[]

  @@index([customerId, createdAt])
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

model BookingSeat {
  id        String   @id @default(uuid())
  booking   Booking  @relation(fields: [bookingId], references: [id])
  bookingId String
  showSeat  ShowSeat @relation(fields: [showSeatId], references: [id])
  /// The seatbelt: Postgres refuses to record one show-seat in two bookings,
  /// even if every application-level check were wrong.
  showSeatId     String  @unique
  priceAtBooking Decimal
}

model WaitlistEntry {
  id             String         @id @default(uuid())
  show           Show           @relation(fields: [showId], references: [id])
  showId         String
  category       SeatCategory   @relation(fields: [categoryId], references: [id])
  categoryId     String
  customer       User           @relation(fields: [customerId], references: [id])
  customerId     String
  status         WaitlistStatus @default(WAITING)
  joinedAt       DateTime       @default(now())
  offeredSeatId  String?
  offerToken     String?        @unique
  offerExpiresAt DateTime?

  @@index([showId, categoryId, status, joinedAt])
}

enum WaitlistStatus {
  WAITING
  OFFERED
  EXPIRED
  CONVERTED
  CANCELLED
}
