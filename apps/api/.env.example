# Copy to apps/api/.env and fill in. Never commit the filled-in file.
# Everything below is read and validated by apps/api/src/env.ts.

NODE_ENV=development
PORT=4000

# Comma-separated list of origins allowed to call this API.
WEB_URL=http://localhost:5173

# --- Database: Supabase (https://supabase.com) ------------------------------
# Dashboard → Connect. Supabase offers THREE strings; take these two.
#
#   DATABASE_URL — TRANSACTION pooler, port 6543, ?pgbouncer=true
#                  Used by the running app. Transaction mode gives each
#                  transaction its own connection for its whole lifetime, so
#                  BEGIN … FOR UPDATE … COMMIT works exactly as intended.
#                  `pgbouncer=true` is required — it disables prepared
#                  statements, which the pooler cannot support.
#
#   DIRECT_URL   — SESSION pooler, port 5432, same pooler host.
#                  Used by `prisma migrate` ONLY. Migrations take advisory
#                  locks, which are session state, which the transaction
#                  pooler throws away between statements.
#
# Do NOT use the third option (`db.<ref>.supabase.co`, "direct connection") —
# it is IPv6-only without the paid IPv4 add-on, and Render cannot reach it.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Redis: Upstash (https://upstash.com) -----------------------------------
# Job queues (hold/offer sweepers, email) and the Socket.IO adapter.
REDIS_URL="rediss://default:password@region.upstash.io:6379"

# --- Auth -------------------------------------------------------------------
# Minimum 32 chars. Generate with: openssl rand -base64 48
JWT_SECRET=""
JWT_EXPIRES_IN=15m

# --- Email: Resend (https://resend.com) -------------------------------------
# onboarding@resend.dev works without a verified domain, but only sends to the
# address that owns the Resend account. Verify a domain for real delivery.
RESEND_API_KEY=""
MAIL_FROM="Ticket Booking <onboarding@resend.dev>"

# --- Seat hold and waitlist tuning ------------------------------------------
# The brief calls the hold TTL configurable. Tests set these to a few seconds.
HOLD_TTL_SECONDS=600
OFFER_TTL_SECONDS=600
SWEEPER_INTERVAL_MS=10000
MAX_SEATS_PER_HOLD=6
MAX_ACTIVE_HOLDS_PER_USER=2
