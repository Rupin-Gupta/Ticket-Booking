# Copy to .env and fill in. Every value here is a placeholder, never a real key.
# Variable names are identical to the retired TypeScript API, so an existing
# .env carries over unchanged.

NODE_ENV=development
PORT=4000

# Comma-separated origins allowed to call the API.
WEB_URL=http://localhost:5173

# --- Supabase -----------------------------------------------------------------
# TWO strings, and a third that must NEVER be used.
#   DATABASE_URL = transaction pooler, port 6543. Runtime queries.
#   DIRECT_URL   = session pooler,     port 5432. Migrations only.
# The direct db.<ref>.supabase.co host is IPv6-only and unreachable from Render.
#
# `?pgbouncer=true` was a Prisma-only flag and is now stripped automatically —
# harmless to leave in place, so an old .env keeps working.
#
# The pooler cannot carry prepared statements, which is why this project uses
# psycopg3 with prepare_threshold=None and NOT asyncpg. See RULE 16.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Test database (a SECOND Supabase project) --------------------------------
# Tests refuse to run without these rather than falling back to the database
# above. A suite that quietly writes to production is worse than one that will
# not start.
DATABASE_URL_TEST=""
DIRECT_URL_TEST=""

# --- Redis (Upstash) ----------------------------------------------------------
# rediss:// — TLS. Used for the email queue and the Socket.IO adapter.
REDIS_URL=""

# --- Auth ---------------------------------------------------------------------
# At least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=""
JWT_EXPIRES_IN=15m

# --- Email (Resend) -----------------------------------------------------------
RESEND_API_KEY=""
MAIL_FROM="Ticket Booking <onboarding@resend.dev>"
# Send every message here instead of the real recipient. Resend's shared
# onboarding@resend.dev sender only delivers to the account owner, so without
# this the seeded demo customers can never receive anything. Refused in
# production — silently redirecting real tickets is worse than not sending.
MAIL_REDIRECT_TO=""

# --- Seat hold / waitlist tuning ----------------------------------------------
HOLD_TTL_SECONDS=600
OFFER_TTL_SECONDS=600
SWEEPER_INTERVAL_MS=10000
MAX_SEATS_PER_HOLD=6
MAX_ACTIVE_HOLDS_PER_USER=2
